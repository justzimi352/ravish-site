---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import DonateBand from '@/components/DonateBand.astro';
import Icon from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import { webinarSeries } from '@/data/programmes';
import { site } from '@/data/site';
---

<BaseLayout
  title="Education & Webinars"
  description="A free ten-part USMLE series, the AMC and AHPRA pathway for Australia, research and meta-analysis methods, and trauma care — free academic webinars for medical students nationwide."
>
  <PageHero
    eyebrow="Free, and open to any student"
    title="Education & Webinars"
    lead="The other half of RAVISH's mission is the students running it. Every webinar is free, hosted by a different chapter, and open to any medical student in the country — including the ones at colleges with no cabinet of their own."
  />

  <section class="band-silk band-tight relative" aria-label="Webinar figures">
    <span class="silk-weave" aria-hidden="true"></span>
    <div class="shell relative grid gap-8 sm:grid-cols-3">
      <div data-reveal="rise">
        <p class="numeral-gold">10</p>
        <p class="mt-2 text-small font-medium text-paper">parts in the USMLE series</p>
      </div>
      <div data-reveal="rise" style="--reveal-delay:80">
        <p class="numeral-gold">200–260</p>
        <p class="mt-2 text-small font-medium text-paper">registrations per recent session</p>
      </div>
      <div data-reveal="rise" style="--reveal-delay:160">
        <p class="numeral-gold">0</p>
        <p class="mt-2 text-small font-medium text-paper">rupees, for any of it</p>
      </div>
    </div>
  </section>

  <section class="band-paper band" aria-labelledby="series-title">
    <div class="shell">
      <SectionHead
        id="series-title"
        eyebrow="The series"
        title="What is taught, and by whom"
        lead="Sessions are led by students and graduates who have actually sat the exam or walked the pathway, which is the only credential that matters to the audience."
      />

      <ul class="mt-14 grid gap-6 md:grid-cols-2">
        {
          webinarSeries.map((item, i) => (
            <li class="card flex flex-col p-8" data-reveal="rise" style={`--reveal-delay:${i * 85}`}>
              <span class="card-edge" aria-hidden="true" />
              <div class="flex items-start justify-between gap-4">
                <span
                  class="flex h-12 w-12 items-center justify-center rounded-full text-crimson"
                  style="background:color-mix(in oklab, var(--color-crimson) 7%, transparent)"
                >
                  <Icon name="cap" size={22} />
                </span>
                <span class="text-caption font-semibold tracking-[0.05em] text-muted uppercase">
                  {item.parts}
                </span>
              </div>
              <h3 class="display-h3 mt-5 text-crimson">{item.title}</h3>
              <p class="mt-1.5 text-caption text-muted">Since {item.since}</p>
              <p class="mt-4 text-small leading-relaxed text-ash">{item.note}</p>
            </li>
          ))
        }
      </ul>

      <div class="card mt-10 flex items-start gap-4 p-7" data-reveal="rise">
        <span class="card-edge" aria-hidden="true"></span>
        <Icon name="file" size={20} class="mt-0.5 shrink-0 text-crimson" />
        <p class="text-small leading-relaxed text-ash">
          <strong class="font-semibold">E-certificates</strong> go to every participant. For a
          second-year student building a portfolio, that is not a trivial detail — it is often the first
          line on it.
        </p>
      </div>
    </div>
  </section>

  <section class="band-paper-deep band" aria-labelledby="why-title">
    <div class="shell">
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
        <div>
          <SectionHead id="why-title" eyebrow="Why a health NGO runs webinars" title="Because the volunteers are the point too" />
          <div class="mt-9 flex flex-col gap-5">
            <p class="measure text-body text-ash">
              RAVISH’s mission has two halves: free healthcare for underserved communities, and
              <em>empowering youth to lead with responsibility and compassion</em>. The second half is not
              decoration. A cabinet president in their fourth year is running budgets, logistics,
              partnerships and a team of dozens.
            </p>
            <p class="measure text-body text-ash">
              The webinars are the academic expression of that. A student who cannot afford a USMLE prep
              course gets ten sessions free, taught by someone two years ahead of them. A student who
              wants to publish gets a walkthrough of how a systematic review is actually assembled.
            </p>
            <p class="measure text-body text-ash">
              And each session is hosted by a different chapter, which means forty cabinets a year get
              practice at organising something with an audience.
            </p>
          </div>
        </div>

        <div class="card self-start p-8" data-reveal="rise-lg">
          <span class="card-edge" aria-hidden="true"></span>
          <p class="eyebrow text-crimson">Attending a session</p>
          <p class="mt-4 text-body leading-relaxed text-ash">
            Webinars are announced on Instagram, usually a week or two ahead, with a registration link.
            There is no membership and no fee — you do not need to be a RAVISH volunteer to attend.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <Button href={site.instagram} variant="quiet" iconStart="instagram" external>
              Watch for announcements
            </Button>
            <Button href="/get-involved/cabinets" variant="quiet">Host one</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <DonateBand compact />
</BaseLayout>
