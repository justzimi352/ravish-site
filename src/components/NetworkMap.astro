---
import DottedMap from 'dotted-map';
import { cities, chapters } from '@/data/chapters';

/**
 * A dotted map of Pakistan with the cabinet network plotted on it.
 *
 * The dot grid and every pin coordinate are computed by `dotted-map` at BUILD
 * time, in Node — the page receives finished SVG. That is why this is an
 * .astro file and not the React original: no framework runtime, no
 * framer-motion, no client JavaScript at all. The arcs draw themselves with a
 * CSS stroke-dashoffset transition and the pins pulse with SMIL.
 */
interface Props {
  linkBase?: string;
  class?: string;
}

const { linkBase = '/chapters', class: className = '' } = Astro.props;

const countFor = (city: string) => chapters.filter((c) => c.city === city && !c.dormant).length;

const MAP_OPTS = { height: 58, grid: 'diagonal' as const, countries: ['PAK'] };

// 1. the land itself
const base = new DottedMap(MAP_OPTS);
const dotsSvg = base.getSVG({
  radius: 0.3,
  color: '#C89A6A',
  shape: 'circle',
  backgroundColor: 'transparent',
});

const viewBox = dotsSvg.match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 68 58';
const [, , vbW, vbH] = viewBox.split(' ').map(Number);
const dotsInner = dotsSvg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');

// 2. ask the same grid where each city lands, so pins sit on the dot lattice
const locator = new DottedMap(MAP_OPTS);
for (const city of cities) {
  locator.addPin({ lat: city.lat, lng: city.lon, data: city.name, svgOptions: { color: 'transparent', radius: 0.01 } });
}
const pinPoints = new Map<string, { x: number; y: number }>();
for (const p of locator.getPoints() as { x: number; y: number; data?: string }[]) {
  if (p.data) pinPoints.set(p.data, { x: p.x, y: p.y });
}

const points = cities
  .map((city) => {
    const at = pinPoints.get(city.name);
    if (!at) return null;
    const count = city.kind === 'cabinet' ? countFor(city.name) : 0;
    return {
      ...city,
      x: at.x,
      y: at.y,
      count,
      r: city.kind === 'cabinet' ? 0.72 + Math.min(count, 17) * 0.085 : 0.4,
    };
  })
  .filter(Boolean) as (typeof cities[number] & { x: number; y: number; count: number; r: number })[];

const lahore = points.find((p) => p.name === 'Lahore')!;

/** A gentle arc from the founding chapter out to each cabinet city. */
const arc = (to: { x: number; y: number }) => {
  const dx = to.x - lahore.x;
  const dy = to.y - lahore.y;
  const len = Math.hypot(dx, dy) || 1;
  const bow = Math.min(len * 0.22, 7);
  const mx = (lahore.x + to.x) / 2 - (dy / len) * bow;
  const my = (lahore.y + to.y) / 2 + (dx / len) * bow;
  return `M${lahore.x.toFixed(2)} ${lahore.y.toFixed(2)} Q${mx.toFixed(2)} ${my.toFixed(2)} ${to.x.toFixed(2)} ${to.y.toFixed(2)}`;
};

const cabinetPoints = points.filter((p) => p.kind === 'cabinet').sort((a, b) => a.r - b.r);
const opPoints = points.filter((p) => p.kind === 'operations');
const cabinetCityCount = cabinetPoints.length;
const slug = (name: string) => name.toLowerCase().replace(/\s+/g, '-');
---

<figure class={`m-0 ${className}`}>
  <div class="dotmap" data-map style={`--vb-w:${vbW};--vb-h:${vbH}`}>
    <svg
      viewBox={viewBox}
      class="dotmap-svg"
      role="img"
      aria-label={`A dotted map of Pakistan. RAVISH has local cabinets in ${cabinetCityCount} cities and runs camps in ${cities.length} cities in total. The full list follows below.`}
      data-reveal="fade"
    >
      <defs>
        <linearGradient id="dm-arc" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#A1080A" stop-opacity="0.85" />
          <stop offset="55%" stop-color="#E8481F" stop-opacity="0.6" />
          <stop offset="100%" stop-color="#F2A03D" stop-opacity="0.25" />
        </linearGradient>
        <radialGradient id="dm-pin" cx="34%" cy="28%" r="80%">
          <stop offset="0%" stop-color="#F87D05" />
          <stop offset="100%" stop-color="#A1080A" />
        </radialGradient>
      </defs>

      <!-- the land, as dots -->
      <g class="dotmap-land" set:html={dotsInner} />

      <!-- arcs back to the founding chapter -->
      <g fill="none" stroke="url(#dm-arc)" stroke-width="0.17" stroke-linecap="round">
        {
          cabinetPoints
            .filter((p) => p.name !== 'Lahore')
            .map((p, i) => <path d={arc(p)} class="dotmap-arc" style={`--arc-i:${i}`} pathLength="1" />)
        }
      </g>

      <!-- cities we work in but have no cabinet -->
      {
        opPoints.map((p, i) => (
          <g class="dotmap-node" style={`--node-i:${i + 8}`}>
            <circle cx={p.x} cy={p.y} r={p.r} fill="none" stroke="#A1080A" stroke-width="0.16" opacity="0.6" />
            <circle cx={p.x} cy={p.y} r="0.14" fill="#A1080A" opacity="0.7" />
          </g>
        ))
      }

      <!-- cabinet cities -->
      {
        cabinetPoints.map((p, i) => (
          <g class="dotmap-node dotmap-node-cabinet" style={`--node-i:${i}`}>
            <circle cx={p.x} cy={p.y} r={p.r} fill={`url(#dm-pin)`} opacity="0.32" class="dotmap-pulse">
              <animate
                attributeName="r"
                values={`${p.r};${p.r * 2.6};${p.r}`}
                dur="2.8s"
                begin={`${i * 0.22}s`}
                repeatCount="indefinite"
              />
              <animate
                attributeName="opacity"
                values="0.32;0;0.32"
                dur="2.8s"
                begin={`${i * 0.22}s`}
                repeatCount="indefinite"
              />
            </circle>
            <circle cx={p.x} cy={p.y} r={p.r} fill="url(#dm-pin)" />
            <circle cx={p.x} cy={p.y} r={p.r} fill="none" stroke="#FDEECA" stroke-width="0.13" opacity="0.85" />
          </g>
        ))
      }
    </svg>

    <!-- Labels and hit targets live in HTML, not SVG: crisper type at any size,
         real focus rings, and proper links. -->
    <div class="dotmap-labels">
      {
        cabinetPoints.map((p) => (
          <a
            href={`${linkBase}#city-${slug(p.name)}`}
            class={`dotmap-label ${p.labelAnchor === 'end' ? 'dotmap-label-left' : ''}`}
            style={`left:${((p.x / vbW) * 100).toFixed(3)}%; top:${((p.y / vbH) * 100).toFixed(3)}%; --lx:${
              p.labelDx ?? 0
            }px; --ly:${p.labelDy ?? 0}px`}
            data-city={p.name}
            data-count={p.count}
          >
            <span class="dotmap-label-text">
              {p.name}
              {p.count >= 3 && <span class="dotmap-label-count">{p.count}</span>}
            </span>
          </a>
        ))
      }
      {
        opPoints.map((p) => (
          <span
            class="dotmap-label dotmap-label-op"
            style={`left:${((p.x / vbW) * 100).toFixed(3)}%; top:${((p.y / vbH) * 100).toFixed(3)}%`}
            data-city={p.name}
            data-count="0"
            tabindex="0"
            role="img"
            aria-label={`${p.name} — camps run here, no cabinet yet`}
          />
        ))
      }
    </div>

    <div class="dotmap-readout" data-map-readout aria-hidden="true"><span></span></div>
  </div>

  <figcaption class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-caption text-muted">
    <span class="flex items-center gap-2">
      <span class="inline-block h-3 w-3 rounded-full" style="background:linear-gradient(135deg,#F87D05,#A1080A)"></span>
      Cabinet city — the number is how many chapters
    </span>
    <span class="flex items-center gap-2">
      <span class="inline-block h-3 w-3 rounded-full border-[1.5px] border-crimson/55"></span>
      Camps run here, no cabinet yet
    </span>
    <span>Plotted from actual coordinates.</span>
  </figcaption>
</figure>

<style>
  .dotmap {
    position: relative;
    width: 100%;
  }

  .dotmap-svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* the land fades up softly rather than snapping in */
  .dotmap-land {
    opacity: 0;
    transition: opacity 1.1s var(--ease-soft);
    mask-image: linear-gradient(to bottom, transparent, #000 9%, #000 91%, transparent);
  }
  .dotmap-svg.is-in .dotmap-land,
  .is-in .dotmap-land {
    opacity: 0.85;
  }

  .dotmap-arc {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s var(--ease-expo);
    transition-delay: calc(var(--arc-i) * 70ms + 450ms);
  }
  .dotmap-svg.is-in .dotmap-arc,
  .is-in .dotmap-arc {
    stroke-dashoffset: 0;
  }

  .dotmap-node {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.3);
    transition:
      opacity 0.5s var(--ease-expo),
      transform 0.62s var(--ease-expo);
    transition-delay: calc(var(--node-i) * 45ms + 620ms);
  }
  .dotmap-svg.is-in .dotmap-node,
  .is-in .dotmap-node {
    opacity: 1;
    transform: scale(1);
  }

  /* --- labels ------------------------------------------------------ */
  .dotmap-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .dotmap-label {
    position: absolute;
    /* --lx/--ly are the per-city nudges; several Pakistani cities sit close
       enough together that their labels would otherwise overlap. */
    transform: translate(calc(0.75rem + var(--lx, 0px)), calc(-50% + var(--ly, 0px)));
    pointer-events: auto;
    text-decoration: none;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.5s var(--ease-soft);
    transition-delay: 0.9s;
  }
  /* flipped to sit on the left of its pin */
  .dotmap-label-left {
    transform: translate(calc(-100% - 0.75rem + var(--lx, 0px)), calc(-50% + var(--ly, 0px)));
  }
  .is-in .dotmap-label {
    opacity: 1;
  }

  .dotmap-label-text {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-ash);
    transition:
      color 0.25s var(--ease-soft),
      font-weight 0.25s;
  }
  .dotmap-label:hover .dotmap-label-text,
  .dotmap-label:focus-visible .dotmap-label-text {
    color: var(--color-crimson);
    font-weight: 700;
  }

  .dotmap-label-count {
    display: inline-flex;
    min-width: 1.125rem;
    height: 1.125rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    /* Solid crimson, not the sunrise gradient — the gradient's ember end put
       cream at 3.4:1 behind 10px type. Flat crimson reads 7.2:1. */
    background: var(--color-crimson);
    color: var(--color-paper);
    font-size: 0.6875rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    padding-inline: 0.28rem;
  }

  /* the operations cities get a hit target but no visible label */
  .dotmap-label-op {
    width: 1.5rem;
    height: 1.5rem;
    transform: translate(-50%, -50%);
    border-radius: 999px;
  }

  .dotmap-readout {
    position: absolute;
    left: 50%;
    top: 0.25rem;
    transform: translateX(-50%);
    opacity: 0;
    transition: opacity 0.28s var(--ease-soft);
    pointer-events: none;
  }
  .dotmap-readout > span {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgb(255 248 236 / 0.94);
    backdrop-filter: blur(10px);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-card);
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-crimson);
    white-space: nowrap;
  }

  /* Labels crowd badly on a phone. Keep the pins and the pulse, drop the type
     — the directory underneath carries the same information as real text. */
  @media (max-width: 767px) {
    .dotmap-label-text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dotmap-land {
      opacity: 0.85 !important;
    }
    .dotmap-arc {
      stroke-dashoffset: 0 !important;
    }
    .dotmap-node {
      opacity: 1 !important;
      transform: scale(1);
    }
    .dotmap-label {
      opacity: 1 !important;
      transform: translate(calc(0.75rem + var(--lx, 0px)), calc(-50% + var(--ly, 0px)));
    }
    .dotmap-label-left {
      transform: translate(calc(-100% - 0.75rem + var(--lx, 0px)), calc(-50% + var(--ly, 0px)));
    }
    .dotmap-pulse animate {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((root) => {
    const readout = root.querySelector<HTMLElement>('[data-map-readout]');
    const chip = readout?.querySelector('span');
    if (!readout || !chip) return;

    root.querySelectorAll<HTMLElement>('[data-city]').forEach((node) => {
      const show = () => {
        const city = node.dataset.city ?? '';
        const count = Number(node.dataset.count ?? 0);
        chip.textContent = count
          ? `${city} — ${count} cabinet${count === 1 ? '' : 's'}`
          : `${city} — camps run here`;
        readout.style.opacity = '1';
      };
      const hide = () => {
        readout.style.opacity = '0';
      };
      node.addEventListener('mouseenter', show);
      node.addEventListener('focus', show);
      node.addEventListener('mouseleave', hide);
      node.addEventListener('blur', hide);
    });

    // reveal the SVG layers when the figure scrolls in
    const svg = root.querySelector<SVGElement>('.dotmap-svg');
    if (!svg) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('is-in');
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          root.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.12 }
    );
    io.observe(root);
  });
</script>
