---
interface Props {
  value: number;
  suffix?: string;
  label: string;
  note?: string;
  tone?: 'ink' | 'gold';
  delay?: number;
  class?: string;
}

const { value, suffix = '', label, note, tone = 'ink', delay = 0, class: className = '' } = Astro.props;
const formatted = value.toLocaleString('en-US');
const onGold = tone === 'gold';
---

<div class={`flex flex-col ${className}`} data-reveal="rise" style={`--reveal-delay:${delay}`}>
  <span class="flex items-baseline gap-0.5">
    <span
      class={onGold ? 'numeral-gold' : 'numeral'}
      data-counter={value}
      data-counter-suffix={suffix}
      aria-hidden="true">{formatted}{suffix}</span
    >
    <span class="sr-only">{formatted}{suffix}</span>
  </span>
  <span
    class={`mt-2.5 text-small font-medium ${onGold ? 'text-paper' : 'text-ash'}`}
    style={onGold ? 'opacity:.95' : ''}>{label}</span
  >
  {
    note && (
      <span class={`mt-1 text-caption ${onGold ? 'text-paper/92' : 'text-muted'}`} style="letter-spacing:.01em">
        {note}
      </span>
    )
  }
</div>

<script>
  // Counters tick up once, on enter. Never on a loop.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.counter ?? 0);
      const suffix = el.dataset.counterSuffix ?? '';
      const duration = 1500;
      const start = performance.now();

      const tick = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const current = Math.round(target * easeOut(t));
        el.textContent = current.toLocaleString('en-US') + suffix;
        if (t < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          run(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.55 }
    );

    document.querySelectorAll<HTMLElement>('[data-counter]').forEach((el) => {
      el.textContent = '0' + (el.dataset.counterSuffix ?? '');
      io.observe(el);
    });
  }
</script>
