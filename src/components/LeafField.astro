---
/**
 * The hero's one moving element: gold leaves drifting off the tree, as in the
 * logo. Slow, small, and the only thing on the page that animates on its own.
 * Everything here is decorative — aria-hidden, and switched off entirely under
 * prefers-reduced-motion.
 */
interface Props {
  class?: string;
  count?: number;
  parallax?: boolean;
}

const { class: className = '', count = 16, parallax = true } = Astro.props;

// Deterministic scatter — a seeded pseudo-random so the layout never jumps
// between builds, weighted to the upper-left the way the logo drifts.
const seeded = (i: number, salt: number) => {
  const x = Math.sin(i * 12.9898 + salt * 78.233) * 43758.5453;
  return x - Math.floor(x);
};

const leaves = Array.from({ length: count }, (_, i) => {
  const r1 = seeded(i + 1, 1);
  const r2 = seeded(i + 1, 2);
  const r3 = seeded(i + 1, 3);
  const r4 = seeded(i + 1, 4);
  return {
    left: 4 + r1 * 74,
    top: 3 + r2 * 62,
    size: 7 + r3 * 13,
    rotate: -68 + r4 * 58,
    dur: 17 + r3 * 13,
    delay: -(r1 * 14).toFixed(2),
    opacity: 0.3 + r4 * 0.42,
    depth: 0.18 + r2 * 0.5,
  };
});
---

<div
  class={`pointer-events-none absolute inset-0 overflow-hidden ${className}`}
  aria-hidden="true"
  data-leaf-field={parallax ? 'true' : undefined}
>
  <!-- the sphere's warmth, behind everything -->
  <div
    class="halo absolute rounded-full"
    style="
      right:-14%; top:-24%; width:min(62vw,720px); aspect-ratio:1;
      background: radial-gradient(circle at 34% 30%, rgba(246,116,2,.30) 0%, rgba(232,72,31,.17) 38%, rgba(161,8,10,.06) 62%, transparent 74%);
      filter: blur(6px);
    "
    data-leaf-depth="0.1"
  >
  </div>

  <div
    class="halo absolute rounded-full"
    style="
      left:-18%; bottom:-30%; width:min(48vw,560px); aspect-ratio:1;
      background: radial-gradient(circle at 60% 40%, rgba(242,160,61,.22) 0%, rgba(242,107,31,.10) 45%, transparent 70%);
      animation-delay:-7s; filter: blur(8px);
    "
    data-leaf-depth="0.06"
  >
  </div>

  <!-- concentric arcs, echoing the badge -->
  <svg
    class="absolute"
    style="right:-8%; top:-14%; width:min(52vw,600px); aspect-ratio:1; opacity:.5"
    viewBox="0 0 200 200"
    fill="none"
    data-leaf-depth="0.14"
  >
    <circle cx="100" cy="100" r="86" stroke="#E6D6B4" stroke-width="0.8" />
    <circle cx="100" cy="100" r="66" stroke="#E6D6B4" stroke-width="0.6" stroke-dasharray="2 7" />
    <circle cx="100" cy="100" r="44" stroke="#F2A03D" stroke-width="0.6" opacity="0.55" />
  </svg>

  {
    leaves.map((leaf) => (
      <svg
        class="leaf absolute"
        style={`left:${leaf.left}%; top:${leaf.top}%; width:${leaf.size}px; opacity:${leaf.opacity}; --leaf-dur:${leaf.dur}s; --leaf-delay:${leaf.delay}s; transform:rotate(${leaf.rotate}deg)`}
        viewBox="0 0 20 12"
        fill="none"
        data-leaf-depth={leaf.depth}
      >
        <path
          d="M19 6c-4.6 4.4-9.2 5.6-13 5.2C2.6 10.8.6 8.8 1 6c.4-2.8 3-4.6 6.4-5C11.2.6 15.4 1.9 19 6Z"
          fill="url(#leaf-grad)"
        />
      </svg>
    ))
  }

  <svg width="0" height="0" style="position:absolute">
    <defs>
      <linearGradient id="leaf-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#FDCC4C" />
        <stop offset="55%" stop-color="#F2A03D" />
        <stop offset="100%" stop-color="#E8481F" />
      </linearGradient>
    </defs>
  </svg>
</div>

<script>
  // One very slow parallax drift. rAF-throttled, and off under reduced motion.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  const attach = () => {
    const fields = document.querySelectorAll<HTMLElement>('[data-leaf-field]');
    if (!fields.length || reduce.matches) return;

    const layers: { el: HTMLElement; depth: number; base: string }[] = [];
    fields.forEach((field) => {
      field.querySelectorAll<HTMLElement>('[data-leaf-depth]').forEach((el) => {
        layers.push({
          el,
          depth: Number(el.dataset.leafDepth ?? 0.2),
          base: el.style.transform || '',
        });
      });
    });

    let queued = false;
    const update = () => {
      queued = false;
      const y = window.scrollY;
      if (y > window.innerHeight * 1.4) return;
      for (const layer of layers) {
        layer.el.style.transform = `translate3d(0, ${(y * layer.depth).toFixed(1)}px, 0) ${layer.base}`;
      }
    };

    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true }
    );
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attach);
  } else {
    attach();
  }
</script>
